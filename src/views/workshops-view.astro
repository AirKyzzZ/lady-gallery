---
import BaseLayout from '../layouts/base-layout.astro'
import PageHeader from '../components/page-header.astro'
import { getPath, type Locale } from '../i18n/routes'
import { WORKSHOPS, WORKSHOP_GROUPS } from '../data/event'
import { CATEGORIES } from '../data/taxonomy'
import { WORKSHOPS_COPY } from '../i18n/pages-copy'

type Props = { locale: Locale }

const { locale } = Astro.props
const copy = WORKSHOPS_COPY[locale]
const categoryLabel = (key: string): string | undefined => CATEGORIES.find((c) => c.key === key)?.label[locale]
---

<BaseLayout locale={locale} title={`${copy.title}, Lady Gallery`} description={copy.description}>
  <PageHeader title={copy.title}><p>{copy.intro}</p></PageHeader>
  <div class="wrap workshops">
    {
      WORKSHOP_GROUPS.map((group) => (
        <section class="group" aria-labelledby={`group-${group}`}>
          <header class="group-header">
            <h2 id={`group-${group}`}>{copy.groups[group].title}</h2>
            <p class="group-note">{copy.groups[group].note}</p>
          </header>
          {WORKSHOPS.filter((workshop) => workshop.group === group).map((workshop) => {
            const item = copy.items[workshop.key]
            const related = workshop.category && categoryLabel(workshop.category)
            return (
              <section class="workshop" id={workshop.key} aria-labelledby={`${workshop.key}-title`}>
                <div class="workshop-head">
                  <h3 id={`${workshop.key}-title`}>{workshop.title[locale]}</h3>
                  {(item.players || item.duration) && (
                    <dl class="facts">
                      {item.players && (
                        <div>
                          <dt>{copy.playersLabel}</dt>
                          <dd>{item.players}</dd>
                        </div>
                      )}
                      {item.duration && (
                        <div>
                          <dt>{copy.durationLabel}</dt>
                          <dd>{item.duration}</dd>
                        </div>
                      )}
                    </dl>
                  )}
                  {workshop.category && related && (
                    <a class="related" href={getPath('category', locale, workshop.category)}>
                      {copy.related(related)}
                    </a>
                  )}
                </div>
                <div class="workshop-body">
                  <ol>
                    {item.steps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                  {item.outro && <p class="outro">{item.outro}</p>}
                </div>
              </section>
            )
          })}
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .workshops {
    display: grid;
    gap: var(--space-2xl);
    padding-top: var(--space-l);
  }

  .group {
    display: grid;
    gap: var(--space-l);
  }

  .group-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-m);
  }

  h2 {
    font-size: var(--step-3);
  }

  .group-note {
    color: var(--red);
    font-style: italic;
  }

  .workshop {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: var(--space-s) var(--space-xl);
    padding-top: var(--space-l);
    border-top: 1px solid var(--red);
  }

  h3 {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 400;
  }

  .facts {
    display: grid;
    gap: var(--space-2xs);
    margin: var(--space-s) 0 0;
  }

  .facts div {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
  }

  dt {
    color: var(--red);
    font-style: italic;
  }

  dd {
    margin: 0;
  }

  .related {
    display: inline-block;
    margin-top: var(--space-s);
    font-size: var(--step--1);
  }

  ol {
    padding-left: 1.2rem;
  }

  ol li + li {
    margin-top: 0.4rem;
  }

  .outro {
    margin-top: var(--space-s);
    font-style: italic;
  }

  @media (max-width: 52rem) {
    .workshop {
      grid-template-columns: 1fr;
    }
  }
</style>
