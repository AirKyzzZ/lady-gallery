---
import BaseLayout from '../layouts/base-layout.astro'
import PageHeader from '../components/page-header.astro'
import type { Locale } from '../i18n/routes'
import { EVENT } from '../data/event'
import { PARTNERS_COPY } from '../i18n/pages-copy'

type Props = { locale: Locale }

const { locale } = Astro.props
const copy = PARTNERS_COPY[locale]
---

<BaseLayout locale={locale} title={`${copy.title}, Lady Gallery`} description={copy.description}>
  <PageHeader title={copy.title} />
  <div class="wrap prose body">
    {copy.paragraphs.map((p) => <p>{p}</p>)}
    <p><a class="button" href={EVENT.instagramUrl} rel="noopener">{copy.cta}</a></p>
  </div>
</BaseLayout>

<style>
  .body {
    padding-top: var(--space-l);
    font-size: var(--step-1);
    line-height: 1.55;
  }
</style>
