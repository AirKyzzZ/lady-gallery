---
import View from '../../views/category-view.astro'
import { CATEGORIES } from '../../data/taxonomy'

export const getStaticPaths = () =>
  CATEGORIES.map((category) => ({ params: { category: category.slug.fr }, props: { key: category.key } }))

const { key } = Astro.props
---

<View locale="fr" category={key} />
