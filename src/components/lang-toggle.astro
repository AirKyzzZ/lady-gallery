---
import { getAlternatePath, type Locale } from '../i18n/routes'
import { t } from '../i18n/ui'

type Props = { locale: Locale; pathname: string }

const { locale, pathname } = Astro.props
const target: Locale = locale === 'fr' ? 'en' : 'fr'
---

<a
  class="lang-toggle"
  href={getAlternatePath(pathname, target)}
  hreflang={target}
  lang={target}
  aria-label={t(locale, 'lang.switchLabel')}
>
  <span aria-hidden="true">{t(locale, 'lang.switch')}</span>
</a>

<style>
  .lang-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--navy);
    color: var(--navy);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .lang-toggle:hover {
    background: var(--navy);
    color: var(--cream);
  }
</style>
