---
export type PictogramName = 'music' | 'literature' | 'visual-arts' | 'film' | 'fashion'

type Props = {
  name: PictogramName
  size?: number
  class?: string
}

const { name, size = 48, class: className } = Astro.props
---

<svg
  class:list={['pictogram', className]}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'music' && (
      <>
        <circle cx="22" cy="26" r="16" />
        <circle cx="22" cy="26" r="11" stroke-dasharray="2 3" />
        <circle cx="22" cy="26" r="4.5" />
        <circle cx="22" cy="26" r="1" fill="currentColor" />
        <path d="M41 5v15l-8 6" />
        <circle cx="41" cy="5" r="1.5" />
      </>
    )
  }
  {
    name === 'literature' && (
      <>
        <path d="M24 13c-5-4-12-5-19-4v27c7-1 14 0 19 4 5-4 12-5 19-4V9c-7-1-14 0-19 4Z" />
        <path d="M24 13v27" />
        <path d="M10 16c3 0 6 .5 9 2M10 22c3 0 6 .5 9 2M29 18c3-1.5 6-2 9-2M29 24c3-1.5 6-2 9-2" />
      </>
    )
  }
  {
    name === 'visual-arts' && (
      <>
        <path d="M24 6C13 6 5 13.5 5 23c0 8 6 13 12 12 4-.6 4-5 7-5s3 4 7 4c7 0 12-5 12-11 0-9.5-8.5-17-19-17Z" />
        <circle cx="15" cy="17" r="2.5" />
        <circle cx="24" cy="13" r="2.5" />
        <circle cx="33" cy="17" r="2.5" />
        <circle cx="13" cy="26" r="2.5" />
        <path d="M30 42l12-14" />
        <path d="M42 28l2-3" stroke-width="3" />
      </>
    )
  }
  {
    name === 'film' && (
      <>
        <circle cx="14" cy="11" r="6" />
        <circle cx="28" cy="10" r="5" />
        <rect x="6" y="18" width="26" height="15" rx="2" />
        <path d="M32 22l9-4v15l-9-4" />
        <path d="M14 33l-5 11M22 33l5 11M18 33v11" />
      </>
    )
  }
  {
    name === 'fashion' && (
      <>
        <path d="M24 4.5a3 3 0 1 1 3 3c-1.5 0-3 1-3 2.5V12" />
        <path d="M24 12L8 20h32L24 12Z" />
        <path d="M18 20l-1 6 7 3 7-3-1-6" />
        <path d="M17 26l-7 17h28l-7-17" />
        <path d="M17 26c2 3 12 3 14 0" />
      </>
    )
  }
</svg>
