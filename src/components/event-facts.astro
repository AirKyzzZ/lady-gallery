---
import { EVENT } from '../data/event'
import type { Locale } from '../i18n/routes'
import { t } from '../i18n/ui'

type Props = { locale: Locale }

const { locale } = Astro.props
const labels = {
  fr: { date: 'Date', time: 'Horaires', place: 'Lieu', price: 'Entrée', title: 'Billet d’entrée', stamp: 'Laissez-passer' },
  en: { date: 'Date', time: 'Time', place: 'Venue', price: 'Entry', title: 'Admission ticket', stamp: 'Admit one' },
}[locale]
const rows = [
  { label: labels.date, value: EVENT.date[locale], tbc: true },
  { label: labels.time, value: EVENT.time[locale], tbc: true },
  { label: labels.place, value: `${EVENT.venue[locale]}, ${EVENT.address[locale]}`, tbc: true },
  { label: labels.price, value: EVENT.price[locale], tbc: false },
]
---

<section class="ticket" aria-label={labels.title}>
  <dl>
    {
      rows.map((row) => (
        <div class="ticket-row">
          <dt>{row.label}</dt>
          <dd>
            {row.value}
            {row.tbc && EVENT.isPlaceholder && <span class="tbc">{t(locale, 'tbc')}</span>}
          </dd>
        </div>
      ))
    }
  </dl>
  <p class="ticket-stub" aria-hidden="true">{labels.stamp}</p>
</section>

<style>
  .ticket {
    --notch: 0.9rem;
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    max-width: 34rem;
    background:
      radial-gradient(circle at 0 50%, var(--cream) var(--notch), transparent calc(var(--notch) + 0.5px)),
      radial-gradient(circle at 100% 50%, var(--cream) var(--notch), transparent calc(var(--notch) + 0.5px)),
      var(--navy);
    color: var(--cream);
    filter: drop-shadow(0 10px 18px rgb(41 47 67 / 0.18));
  }

  dl {
    display: grid;
    gap: 0.7rem;
    padding: var(--space-m) var(--space-l);
    margin: 6px;
    border: 1px solid color-mix(in srgb, var(--ochre) 70%, transparent);
    border-right: 0;
  }

  .ticket-row {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-s);
    align-items: baseline;
  }

  dt {
    color: var(--ochre);
    font-size: var(--step--1);
    font-style: italic;
  }

  dd {
    margin: 0;
    font-weight: 500;
    line-height: 1.35;
  }

  .tbc {
    color: var(--beige);
  }

  .ticket-stub {
    display: grid;
    place-items: center;
    margin: 6px 6px 6px 0;
    padding-inline: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--ochre) 70%, transparent);
    border-left: 2px dashed color-mix(in srgb, var(--cream) 60%, transparent);
    color: var(--ochre);
    font-family: var(--font-display);
    font-size: var(--step-1);
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    letter-spacing: 0.12em;
  }

  @media (max-width: 30rem) {
    dl {
      padding: var(--space-m);
    }

    .ticket-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
