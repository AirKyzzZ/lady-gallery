---
import type { ImageMetadata } from 'astro'
import { Image, getImage } from 'astro:assets'

type Props = { image: ImageMetadata; alt: string; caption: string; variant: 1 | 2 | 3 }

const { image, alt, caption, variant } = Astro.props
const full = await getImage({ src: image, width: 1400, format: 'webp' })
---

<figure class:list={['poster', `poster--${variant}`]}>
  <a class="poster-link" href={full.src}>
    <Image src={image} alt={alt} widths={[280, 420, 560, 840]} sizes="(max-width: 40rem) 70vw, 18rem" format="avif" quality={55} />
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .poster {
    margin: 0;
  }

  .poster-link {
    display: block;
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.04),
      0 14px 24px -12px rgb(41 47 67 / 0.45);
    transition: transform 0.2s ease;
  }

  .poster-link img {
    display: block;
    width: 100%;
    height: auto;
  }

  figcaption {
    margin-top: 0.75rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
    font-style: italic;
  }

  .poster--1 .poster-link {
    transform: rotate(-2.5deg);
  }

  .poster--2 .poster-link {
    transform: rotate(1.5deg) translateY(1rem);
  }

  .poster--3 .poster-link {
    transform: rotate(-1deg);
  }

  .poster .poster-link:hover,
  .poster .poster-link:focus-visible {
    transform: rotate(0deg) scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-link {
      transition: none;
    }
  }
</style>
