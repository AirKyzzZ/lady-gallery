---
import '@fontsource/poiret-one/latin.css'
import '@fontsource/poiret-one/latin-ext.css'
import '@fontsource-variable/outfit/wght.css'
import '../styles/global.css'
import poiretLatin from '@fontsource/poiret-one/files/poiret-one-latin-400-normal.woff2?url'
import outfitLatin from '@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url'
import type { Locale } from '../i18n/routes'
import { t } from '../i18n/ui'
import SiteHeader from '../components/site-header.astro'
import SiteFooter from '../components/site-footer.astro'
import SeoHead from '../components/seo-head.astro'
import JsonLd from '../components/json-ld.astro'

type Props = {
  locale: Locale
  title: string
  description: string
  noindex?: boolean
  image?: string
  jsonLd?: Record<string, unknown>[]
}

const { locale, title, description, noindex = false, image, jsonLd } = Astro.props
const pathname = Astro.url.pathname
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="theme-color" content="#f3ebe0" />
    <SeoHead locale={locale} title={title} description={description} image={image} noindex={noindex} />
    {jsonLd && <JsonLd nodes={jsonLd} />}
    <link rel="preload" href={poiretLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={outfitLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'site.skip')}</a>
    <SiteHeader locale={locale} pathname={pathname} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} pathname={pathname} />
  </body>
</html>
